{
  "name": "demoqa-test-automation-framework",
  "version": "1.0.0",
  "description": "End-to-end, API and non-functional test suite for demoqa.com using Playwright and the Page Object Model",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:a11y": "playwright test --grep @a11y --project=chromium",
    "test:visual": "playwright test --grep @visual --project=chromium",
    "test:visual:update": "playwright test --grep @visual --project=chromium --update-snapshots",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "e2e",
    "page-object-model",
    "test-automation"
  ],
  "author": "Afzal Ahmed",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
